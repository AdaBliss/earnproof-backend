# Hash Versioning Configuration for Issue #386
# 
# These environment variables control the versioned token hashing behavior.
# All are optional; defaults are secure and backward-compatible.

# Minimum acceptable hash version for tokens.
# Tokens using versions below this threshold are considered "weak" and trigger alerts.
# 
# Common values:
#   1 = Accept any version (legacy)
#   2 = Require PBKDF2 (current default, recommended)
#   
# Default: 2
HASH_POLICY_MIN_VERSION=2

# PBKDF2 iteration count for v2 hashes (new tokens only).
# Higher values increase security but also increase CPU cost.
# This only affects NEW tokens created after deployment;
# old v1 and v2 tokens continue to verify with their original parameters.
#
# Common values:
#   100000 = NIST SP 800-132 recommended (default)
#   120000 = Slightly increased security (1-5% CPU overhead)
#   150000 = Higher security (10-15% CPU overhead)
#
# Do NOT reduce below 100000 unless you have specific performance constraints.
# Default: 100000
HASH_POLICY_PBKDF2_ITERATIONS=100000

# Reject weak-version tokens completely, or allow them with progressive upgrade?
#
# false (default, recommended for gradual migration):
#   - Old-version tokens verify successfully
#   - On successful verify, token is re-hashed with current version atomically
#   - No user re-authentication required
#   - Allows gradual migration over 1-2 months
#
# true (strict mode, for immediate enforcement):
#   - Weak-version tokens fail verification immediately
#   - Users must re-authenticate/re-issue tokens
#   - Use only after all existing tokens have been upgraded (30+ days after deployment)
#
# Timeline recommendation:
#   Week 0: Deploy with HASH_POLICY_REJECT_WEAK=false (default)
#   Week 2: Verify in metrics that weak tokens still exist; continue with false
#   Week 4: Set HASH_POLICY_REJECT_WEAK=true for hard enforcement
#
# Default: false
HASH_POLICY_REJECT_WEAK=false

# [Advanced] Disable progressive upgrade (keep for debugging only)
# If set to "true", old tokens will NOT be automatically re-hashed on verification.
# This is useful for testing but should never be enabled in production.
#
# Default: (not set; progressive upgrade enabled)
# HASH_POLICY_DISABLE_UPGRADE=false
